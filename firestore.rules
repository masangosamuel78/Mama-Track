rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // MIDWIVES
    match /midwives/{midwifeId} {
      allow get: if isSignedIn();
      allow create: if isOwner(midwifeId) && isValidMidwife(incoming());
      allow update: if isOwner(midwifeId) && isValidMidwife(incoming());
    }

    function isValidMidwife(data) {
      return data.keys().hasAll(['uid', 'fullName', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.fullName is string && data.fullName.size() <= 200 &&
             data.role in ['midwife', 'chw'];
    }

    // PATIENTS
    match /patients/{patientId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // VISITS
    match /patients/{patientId}/visits/{visitId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidVisit(incoming());
      allow update: if isSignedIn() && isValidVisit(incoming());
    }

    function isValidVisit(data) {
      return data.keys().hasAll(['patientId', 'midwifeId', 'visitDate', 'visitType']) &&
             data.patientId is string &&
             data.midwifeId == request.auth.uid &&
             data.visitType is string;
    }

    // CHILDREN
    match /patients/{patientId}/children/{childId} {
      allow read, write: if isSignedIn();
    }

    // REMINDERS
    match /reminders/{reminderId} {
      allow read, write: if isSignedIn();
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update: if isSignedIn() && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
